# Application
APP_NAME=AI-Powered HRMS
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/hrms_db

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=YOUR_GEMINI_MODEL
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Security
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30